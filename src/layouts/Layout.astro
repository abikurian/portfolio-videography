---
// Layout.astro — Master HTML layout with SEO metadata & film grain
import FilmGrainOverlay from '../components/FilmGrainOverlay.astro';
import { PORTFOLIO_DATA } from '../data/portfolioData';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${PORTFOLIO_DATA.name} — Video Editor | Kochi, Kerala`,
  description = "Portfolio of Abi Kurian Varghese — Video Editor based in Kochi, Kerala. Specializing in 10-bit S-Log color grading, beat-synced edits, and cinematic narrative cuts.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    {/* Primary SEO Meta Tags */}
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    {/* Open Graph / Facebook */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    {/* Twitter */}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
  </head>
  <body class="bg-bg text-text selection:bg-accent-soft selection:text-text font-sans relative antialiased">
    {/* Monochromatic Film Grain Texture Overlay */}
    <FilmGrainOverlay />

    <slot />
  </body>
</html>
